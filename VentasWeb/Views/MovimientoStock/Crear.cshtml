
@{
    ViewBag.Title = "Movimientos de Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Inventario</a></li>
        <li class="breadcrumb-item active" aria-current="page">Movimientos de Stock</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Registrar Movimiento de Stock
            </div>
            <div class="card-body">
                <form id="formMovimiento">
                    <!-- SECCION FIJA: Tienda y Tipo de Movimiento -->
                    <div class="card border-primary mb-3">
                        <div class="card-header bg-primary text-white">
                            <i class="fa fa-lock"></i> Configuracion del Movimiento
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="cboTienda">Tienda <span class="text-danger">(*)</span></label>
                                        <select class="form-control form-control-sm" id="cboTienda" name="IdTienda">
                                            <option value="0">-- Seleccione Tienda --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="cboTipoMovimiento">Tipo de Movimiento <span class="text-danger">(*)</span></label>
                                        <select class="form-control form-control-sm" id="cboTipoMovimiento" name="IdTipoMov">
                                            <option value="0">-- Seleccione --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-3" id="divNumeroRemito" style="display:none;">
                                    <div class="form-group">
                                        <label for="txtNumeroRemito">Numero de Remito <span class="text-danger">(*)</span></label>
                                        <input type="text" class="form-control form-control-sm" id="txtNumeroRemito" name="NumeroRemito" placeholder="Ej: REM-20251020-001">
                                    </div>
                                </div>
                                <div class="col-sm-3" id="colMotivo">
                                    <div class="form-group">
                                        <label for="txtMotivo">Motivo del Movimiento <span class="text-danger">(*)</span></label>
                                        <input type="text" class="form-control form-control-sm" id="txtMotivo" name="Motivo" placeholder="Ej: Ajuste de inventario, devolucion, etc.">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECCION VARIABLE: Productos -->
                    <div class="card border-success mb-3">
                        <div class="card-header bg-success text-white">
                            <i class="fa fa-box"></i> Agregar Productos
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="txtProducto">Producto <span class="text-danger">(*)</span></label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control form-control-sm" id="txtProducto" readonly placeholder="Seleccione un producto">
                                            <input type="hidden" id="txtIdProducto" name="IdProducto" value="0">
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-primary btn-sm" id="btnBuscarProducto">
                                                    <i class="fa fa-search"></i> Buscar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="txtCantidad">Cantidad <span class="text-danger">(*)</span></label>
                                        <input type="number" class="form-control form-control-sm" id="txtCantidad" name="Cantidad" min="1" value="1">
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label>&nbsp;</label>
                                        <button type="button" class="btn btn-primary btn-sm btn-block" id="btnAgregarProducto">
                                            <i class="fa fa-plus"></i> Agregar Producto
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-sm-12">
                            <h5>Productos a Registrar</h5>
                            <table id="tbDetalleMovimiento" class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Codigo</th>
                                        <th>Cantidad</th>
                                        <th width="60px"></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12">
                            <button type="button" class="btn btn-success btn-sm" id="btnGuardarMovimiento">
                                <i class="fa fa-save"></i> Registrar Movimiento
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" id="btnLimpiar">
                                <i class="fa fa-broom"></i> Limpiar Todo
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Historial de Movimientos de Stock
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4">
                        <label for="cboFiltroTienda">Filtrar por Tienda:</label>
                        <select class="form-control form-control-sm" id="cboFiltroTienda">
                            <option value="0">-- Todas las Tiendas --</option>
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label for="cboOrdenFecha">Ordenar por Fecha:</label>
                        <select class="form-control form-control-sm" id="cboOrdenFecha">
                            <option value="desc">Mas recientes primero</option>
                            <option value="asc">Mas antiguos primero</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label>&nbsp;</label>
                        <button type="button" class="btn btn-primary btn-sm btn-block" id="btnFiltrar">
                            <i class="fa fa-filter"></i> Filtrar
                        </button>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-sm-12">
                        <table id="tbMovimientos" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tienda</th>
                                    <th>Productos</th>
                                    <th>Cantidad</th>
                                    <th>Tipo Movimiento</th>
                                    <th>Motivo</th>
                                    <th>Usuario</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para seleccionar producto -->
<div class="modal fade" id="modalProducto" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="modalProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalProductoLabel">Seleccionar Producto</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table id="tbProductos" class="table table-striped table-bordered nowrap compact" style="width:100%">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Nombre</th>
                            <th>Categoria</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para ver detalle del lote -->
<div class="modal fade" id="modalDetalleLote" tabindex="-1" role="dialog" aria-labelledby="modalDetalleLoteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalDetalleLoteLabel">Detalle del Movimiento</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-sm-6">
                        <strong>Fecha:</strong> <span id="detalleFecha"></span>
                    </div>
                    <div class="col-sm-6">
                        <strong>Usuario:</strong> <span id="detalleUsuario"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-12">
                        <strong>Tipo de Movimiento:</strong> <span id="detalleTipoMovimiento"></span>
                    </div>
                </div>
                <div class="row mb-3" id="detalleRemitoRow" style="display:none;">
                    <div class="col-sm-12">
                        <strong>Numero de Remito:</strong> <span id="detalleNumeroRemito"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-12">
                        <strong>Motivo:</strong> <span id="detalleMotivo"></span>
                    </div>
                </div>
                <hr />
                <h6>Productos Movidos:</h6>
                <table id="tbDetalleProductos" class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Codigo</th>
                            <th>Cantidad</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/MovimientoStock_Crear.js?v=14")" type="text/javascript"></script>
}
