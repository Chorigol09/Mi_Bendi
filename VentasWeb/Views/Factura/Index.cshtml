@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Facturas</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <i class="fas fa-file-invoice-dollar"></i> Gestion de Facturas
            </div>
            <div class="card-body p-2">
                <div class="row mb-3">
                    <div class="col-sm-6">
                        <a href="@Url.Action("Crear", "Factura")" class="btn btn-success">
                            <i class="fas fa-plus"></i> Registrar Nueva Factura
                        </a>
                    </div>
                    <div class="col-sm-3">
                        <label for="cboOrdenFactura" class="col-form-label col-form-label-sm">Orden:</label>
                        <select class="form-control form-control-sm" id="cboOrdenFactura">
                            <option value="desc">Mas recientes primero</option>
                            <option value="asc">Mas antiguos primero</option>
                        </select>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbFacturas" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Numero Factura</th>
                                    <th>ID Orden Compra</th>
                                    <th>Proveedor</th>
                                    <th>Fecha</th>
                                    <th>Productos</th>
                                    <th class="text-right">Cantidad</th>
                                    <th>Total</th>
                                    <th>Pago</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var tableFacturas;

        $(document).ready(function () {
            activarMenu("Compras");

            // Inicializar DataTable
            tableFacturas = $('#tbFacturas').DataTable({
                "ajax": {
                    "url": $.MisUrls.url._ObtenerFacturas,
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    {
                        "data": "IdFactura",
                        "render": function (data) {
                            return '<button class="btn btn-success btn-sm" type="button" onclick="VerFactura(' + data + ')"><i class="far fa-clipboard"></i> Ver</button>';
                        },
                        "orderable": false,
                        "searchable": false,
                        "width": "60px"
                    },
                    { 
                        "data": "NumeroFactura",
                        "render": function (data) {
                            return '<span class="badge badge-primary">' + data + '</span>';
                        },
                        "className": "text-center",
                        "width": "100px"
                    },
                    { 
                        "data": "IdOrdenCompra",
                        "render": function (data) {
                            return '<span class="badge badge-secondary">#' + data + '</span>';
                        },
                        "className": "text-center",
                        "width": "80px"
                    },
                    {
                        "data": "oProveedor",
                        "render": function (data) {
                            var texto = data ? data.RazonSocial : '';
                            if (texto.length > 25) {
                                return '<span title="' + texto + '">' + texto.substring(0, 25) + '...</span>';
                            }
                            return texto;
                        },
                        "width": "150px"
                    },
                    {
                        "data": "FechaOrdenCompra",
                        "render": function (data) {
                            if (data) {
                                return data;
                            }
                            return '';
                        },
                        "className": "text-center",
                        "width": "90px"
                    },
                    {
                        "data": "Productos",
                        "render": function (data) {
                            if (!data || data == '') return '<em class="text-muted">-</em>';
                            if (data.length > 40) {
                                return '<span title="' + data + '">' + data.substring(0, 40) + '...</span>';
                            }
                            return data;
                        },
                        "width": "180px"
                    },
                    {
                        "data": "CantidadProductos",
                        "render": function (data) {
                            return data;
                        },
                        "className": "text-right",
                        "width": "60px"
                    },
                    {
                        "data": "Total",
                        "render": function (data) {
                            // Formatear como $X.XXX,XX (punto para miles, coma para decimales)
                            var numero = parseFloat(data || 0).toFixed(2);
                            var partes = numero.split('.');
                            var entero = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                            var decimal = partes[1];
                            return "$" + entero + "," + decimal;
                        },
                        "className": "text-right",
                        "width": "100px"
                    },
                    {
                        "data": "Estado",
                        "render": function (data) {
                            var badgeClass = '';
                            var badgeSize = 'badge-pill px-2 py-1';
                            var texto = '';
                            
                            if (data == 'Pendiente') {
                                badgeClass = 'badge-warning';
                                texto = 'PENDIENTE';
                            } else if (data == 'Pagada' || data == 'Pagado') {
                                badgeClass = 'badge-success';
                                texto = 'PAGADO';
                            } else if (data == 'Cancelada') {
                                badgeClass = 'badge-danger';
                                texto = 'CANCELADO';
                            } else {
                                badgeClass = 'badge-secondary';
                                texto = data.toUpperCase();
                            }
                            
                            return '<span class="badge ' + badgeClass + ' ' + badgeSize + '" style="font-size: 0.85rem; display: block;">' + texto + '</span>';
                        },
                        "width": "100px"
                    }
                ],
                "language": {
                    "url": $.MisUrls.url.Url_datatable_spanish
                },
                "order": [[1, "desc"]], // Orden por defecto: ID Orden descendente (mas recientes primero)
                "autoWidth": false
            });

            // Evento para cambiar orden de la tabla
            $('#cboOrdenFactura').on('change', function () {
                var orden = $(this).val();
                if (orden == 'asc') {
                    tableFacturas.order([[1, 'asc']]).draw(); // Mas antiguos primero
                } else {
                    tableFacturas.order([[1, 'desc']]).draw(); // Mas recientes primero
                }
            });

        });

        function VerFactura(id) {
            var texto = $.MisUrls.url._DocumentoFactura + "?idfactura=" + id;
            // Abrir en nueva pestaña
            window.open(texto);
        }
    </script>
}
