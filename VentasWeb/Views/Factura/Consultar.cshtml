
@{
    ViewBag.Title = "Consultar Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Consultar Facturas</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <i class="fas fa-file-invoice-dollar"></i> Consultar Facturas
            </div>
            <div class="card-body p-2">
                <div class="row align-items-end">
                    <div class="col-sm-3">
                        <div class="form-group mb-0">
                            <label for="cboProveedor" class="col-form-label col-form-label-sm">Proveedor:</label>
                            <select class="form-control form-control-sm model" id="cboProveedor" name="Proveedor"></select>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group mb-0">
                            <label for="cboEstado" class="col-form-label col-form-label-sm">Estado:</label>
                            <select class="form-control form-control-sm model" id="cboEstado" name="Estado">
                                <option value="">Todos</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Pagada">Pagada</option>
                                <option value="Cancelada">Cancelada</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group mb-0">
                            <label for="cboOrden" class="col-form-label col-form-label-sm">Orden:</label>
                            <select class="form-control form-control-sm model" id="cboOrden" name="Orden">
                                <option value="desc">Más recientes primero</option>
                                <option value="asc">Más antiguos primero</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group mb-0">
                            <button id="btnBuscar" type="button" class="btn btn-sm btn-primary btn-block" onclick="buscar()"><i class="fas fa-search"></i> Buscar</button>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbFacturas" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Número Factura</th>
                                    <th>Proveedor</th>
                                    <th>Fecha Emisión</th>
                                    <th class="text-right">Total</th>
                                    <th>Cant. Prod.</th>
                                    <th>Productos</th>
                                    <th>Pago</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Factura_Consultar.js?v=" + DateTime.Now.Ticks)" type="text/javascript"></script>
}

