@{
    ViewBag.Title = "Detalle Lista de Precios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "ListaPrecio")">Listas de Precios</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalle</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <i class="fa fa-list-alt"></i> <span id="tituloLista">Detalle de Lista de Precios</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="alert alert-info">
                            <strong>Lista:</strong> <span id="infoNombreLista"></span> |
                            <strong>Tipo:</strong> <span id="infoTipoLista"></span> |
                            <strong>Productos:</strong> <span id="infoCantidadProductos"></span> |
                            <strong>Vigentes:</strong> <span id="infoProductosVigentes"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <button type="button" class="btn btn-sm btn-success" onclick="abrirModalAgregarProducto()">
                            <i class="fa fa-plus"></i> Agregar Producto
                        </button>
                        <a href="@Url.Action("Index", "ListaPrecio")" class="btn btn-sm btn-secondary">
                            <i class="fa fa-arrow-left"></i> Volver
                        </a>
                    </div>
                    <div class="col-sm-6 text-right">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary active" onclick="filtrarProductos('todos')">
                                <i class="fa fa-list"></i> Todos
                            </button>
                            <button type="button" class="btn btn-outline-success" onclick="filtrarProductos('vigentes')">
                                <i class="fa fa-check-circle"></i> Vigentes
                            </button>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbProductosLista" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Codigo</th>
                                    <th>Producto</th>
                                    <th>Categoria</th>
                                    <th>Precio Venta</th>
                                    <th>Estado</th>
                                    <th>Vigente</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Agregar Producto -->
<div class="modal fade" id="modalAgregarProducto" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Agregar Producto a Lista de Precios</h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formAgregarProducto">
                    <input type="hidden" id="txtIdListaPrecioAdd" name="IdListaPrecio" value="@ViewBag.IdListaPrecio" />
                    
                    <div class="form-group">
                        <label>Producto <span class="text-danger">*</span></label>
                        <select class="form-control form-control-sm" id="cboProductoAdd" name="IdProducto" required>
                            <option value="">-- Seleccione un producto --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Precio de Venta <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control form-control-sm" id="txtPrecioVentaAdd" name="PrecioVenta" required />
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-success" onclick="guardarProductoLista()">
                    <i class="fa fa-save"></i> Agregar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Producto -->
<div class="modal fade" id="modalEditarProducto" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title">Editar Precio de Producto</h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formEditarProducto">
                    <input type="hidden" id="txtIdListaPrecioDetalle" name="IdListaPrecioDetalle" />
                    
                    <div class="form-group">
                        <label>Producto</label>
                        <input type="text" class="form-control form-control-sm" id="txtProductoNombre" readonly />
                    </div>

                    <div class="form-group">
                        <label>Precio de Venta <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control form-control-sm" id="txtPrecioVentaEdit" name="PrecioVenta" required />
                    </div>

                    <div class="form-group">
                        <label>Estado</label>
                        <select class="form-control form-control-sm" id="cboActivoEdit" name="Activo">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-warning" onclick="actualizarProductoLista()">
                    <i class="fa fa-save"></i> Actualizar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var idListaPrecio = @ViewBag.IdListaPrecio;
    </script>
    <script src="@Url.Content("~/Scripts/Views/ListaPrecio_Detalle.js")" type="text/javascript"></script>
}
