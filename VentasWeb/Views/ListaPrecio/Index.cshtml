@{
    ViewBag.Title = "Listas de Precios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page">Listas de Precios</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <i class="fa fa-list-alt"></i> Gestion de Listas de Precios
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-6">
                        <button type="button" class="btn btn-sm btn-success" onclick="abrirModalNuevaLista()">
                            <i class="fa fa-plus"></i> Nueva Lista de Precios
                        </button>
                    </div>
                </div>
                <hr />
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <table id="tbListasPrecios" class="table table-striped table-bordered nowrap compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tipo</th>
                                    <th>Descripcion</th>
                                    <th>Tienda</th>
                                    <th>Productos</th>
                                    <th>Vigentes</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nueva/Editar Lista -->
<div class="modal fade" id="modalListaPrecio" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalTitulo">Nueva Lista de Precios</h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formListaPrecio">
                    <input type="hidden" id="txtIdListaPrecio" name="IdListaPrecio" value="0" />
                    
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="txtNombre">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="txtNombre" name="Nombre" required />
                        </div>
                        <div class="form-group col-md-6">
                            <label for="cboTipoLista">Tipo de Lista <span class="text-danger">*</span></label>
                            <select class="form-control form-control-sm" id="cboTipoLista" name="TipoLista" required>
                                <option value="">-- Seleccione --</option>
                                <option value="Minorista">Minorista</option>
                                <option value="Mayorista">Mayorista</option>
                                <option value="Distribuidor">Distribuidor</option>
                                <option value="Promocion">Promocion</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="txtDescripcion">Descripcion (opcional)</label>
                        <textarea class="form-control form-control-sm" id="txtDescripcion" name="Descripcion" rows="3" placeholder="Ingrese una descripcion de la lista (opcional)"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="cboTienda">Tienda (opcional)</label>
                            <select class="form-control form-control-sm" id="cboTienda" name="IdTienda">
                                <option value="">-- Todas las tiendas --</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label for="cboActivo">Estado</label>
                            <select class="form-control form-control-sm" id="cboActivo" name="Activo">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>
                    </div>

                    <!-- Nueva sección: Copiar desde otra lista -->
                    <hr />
                    <div class="form-group">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="chkCopiarDesde">
                            <label class="custom-control-label" for="chkCopiarDesde">
                                <strong>Copiar precios desde otra lista</strong>
                            </label>
                        </div>
                        <small class="form-text text-muted">
                            Crea esta lista copiando todos los productos de una lista existente y aplicando un incremento o descuento.
                        </small>
                    </div>

                    <div id="seccionCopiarPrecios" style="display: none;">
                        <div class="card border-secondary">
                            <div class="card-body bg-light">
                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label for="cboListaOrigen">Lista de Origen</label>
                                        <select class="form-control form-control-sm" id="cboListaOrigen">
                                            <option value="0">-- Seleccione una lista --</option>
                                        </select>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label for="txtPorcentajeAjuste">Ajuste de Precio (%)</label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" class="form-control" id="txtPorcentajeAjuste" 
                                                   placeholder="Ej: 10 o -15" step="0.01" value="0" />
                                            <div class="input-group-append">
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </div>
                                        <small class="form-text text-muted">
                                            Positivo para incrementar, negativo para reducir. Ej: 10 (sube 10%), -20 (baja 20%)
                                        </small>
                                    </div>
                                </div>
                                <div class="alert alert-info alert-sm mb-0" role="alert">
                                    <i class="fa fa-info-circle"></i> 
                                    <strong>Ejemplo:</strong> Si lista origen tiene $100 y ajuste es +10%, nuevo precio sera $110. 
                                    Si ajuste es -20%, nuevo precio sera $80.
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary" onclick="guardarListaPrecio()">
                    <i class="fa fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/ListaPrecio_Index.js")" type="text/javascript"></script>
}
