@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
    @Styles.Render("~/Content/css")

    <style>
        html, body { height: 100%; }
        body {
            background:
                linear-gradient(180deg, rgba(90,167,201,0.8) 0%, rgba(47,110,145,0.8) 45%, rgba(31,79,106,0.8) 100%),
                url('@Url.Content("~/Imagenes/Nubes2.jpg")') no-repeat center center fixed;
            background-size: cover;
            color: #fff;
            font-family: "Segoe UI", Roboto, Arial, sans-serif;
            letter-spacing: .2px;
        }

        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
        }

        .auth-panel {
            width: 100%;
            max-width: 420px;
            padding: 28px 28px 32px;
            border-radius: 20px;
            background: rgba(255, 255, 255, .10);
            box-shadow: 0 10px 30px rgba(0,0,0,.20);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
        }

        .brand {
            display: flex;
            justify-content: center;
            margin-bottom: 12px;
        }

        h1.title {
            text-align: center;
            font-weight: 800;
            letter-spacing: .25rem;
            margin: 8px 0 24px;
        }

        .form-control {
            height: 48px;
            border-radius: 16px;
            border: 0;
            background: rgba(255,255,255,.18);
            color: #fff;
            box-shadow: inset 0 2px 0 rgba(0,0,0,.04), 0 2px 6px rgba(0,0,0,.15);
        }

        .form-control:focus {
            background: rgba(255,255,255,.22);
            color: #fff;
            outline: 0;
            box-shadow: 0 0 0 0.2rem rgba(255,255,255,.25);
        }

        ::placeholder { color: rgba(255,255,255,.85); }

        .btn-primary {
            width: 100%;
            height: 46px;
            border-radius: 18px;
            font-weight: 700;
            letter-spacing: .05rem;
            text-transform: uppercase;
            box-shadow: 0 8px 18px rgba(0,0,0,.25);
        }

        .error-box { margin-bottom: 14px; }

        .register {
            color: #ffe78f;
            font-weight: 600;
            text-decoration: none;
        }

        .register:hover { text-decoration: underline; }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 22px 0 8px;
            opacity: .65;
        }

        .divider::before, .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,.45);
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-panel">
            <div class="brand">
                <img src="@Url.Content("~/Imagenes/tienda.png?v=3")" alt="logo" height="72" />
            </div>

            <h1 class="title">BIENVENIDO</h1>

            @* MENSAJE DE ERROR *@
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center error-box" role="alert">
                    @ViewBag.Error
                </div>
            }

            @* FORM LOGIN *@
            <form action="@Url.Content("~/Login/Index")" method="post" autocomplete="off" class="mt-2">
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <input class="form-control" type="email" name="correo"
                           placeholder="email / username"
                           required value="admin@gmail.com" />
                </div>

                <div class="form-group mb-3">
                    <input class="form-control" type="password" name="clave"
                           placeholder="password"
                           required value="admin@gmail.com" />
                </div>

                <button class="btn btn-primary mt-1" type="submit">Ingresar</button>

                <div class="divider mt-4 mb-2"><span></span></div>

                <p class="text-center mb-0">
                    No tienes una cuenta?
                    <a href="@Url.Content("~/Usuarios/Register")" class="register">Registrarse</a>
                </p>
            </form>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
</body>
</html>
