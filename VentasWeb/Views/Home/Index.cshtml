@{
    ViewBag.Title = "Inicio";

    // Saludo según hora local del servidor
    var hora = DateTime.Now.Hour;
    string saludo = (hora >= 6 && hora < 12) ? "Buenos días"
                    : (hora >= 12 && hora < 19) ? "Buenas tardes"
                    : "Buenas noches";

    string nombre = (ViewBag.NombreUsuario as string) ?? "usuario";
    string rol = (ViewBag.RolUsuario as string) ?? "USUARIO";
}

<div class="welcome-card">
    <div class="d-flex align-items-start justify-content-between">
        <div>
            <h1 class="welcome-title">@saludo, @nombre</h1>
            <p class="welcome-sub">Bienvenido de vuelta a tu panel de control</p>
        </div>

        <span class="role-badge">@rol</span>
    </div>

    <div class="welcome-footer mt-3">
        <span>&copy; @DateTime.Now.Year - Mi Bendi</span>
    </div>
</div>

@section estilos{
    <style>
        .welcome-card {
            background: linear-gradient(180deg,#effbff 0%, #eef5ff 100%);
            border-radius: 14px;
            padding: 28px;
            box-shadow: 0 6px 16px rgba(0,0,0,.06);
            border: 1px solid rgba(0,0,0,.04);
        }

        .welcome-title {
            font-weight: 800;
            letter-spacing: .2px;
            margin: 0 0 6px 0;
            color: #0a2233;
        }

        .welcome-sub {
            margin: 0;
            color: #5b7386;
        }

        .role-badge {
            background: #fff;
            border: 1px solid rgba(0,0,0,.06);
            color: #0a2233;
            padding: 8px 14px;
            border-radius: 12px;
            font-weight: 700;
            white-space: nowrap;
            align-self: start;
        }

        .welcome-footer {
            color: #334b5a;
            opacity: .9;
        }

        /* Responsive: apilar en pantallas chicas */
        @@media (max-width: 576px) {
            .welcome-card {
                padding: 20px;
            }

            .role-badge {
                margin-top: 12px;
            }
        }
    </style>
}

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Home_Index.js")" type="text/javascript"></script>
}