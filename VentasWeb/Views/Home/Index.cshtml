@{
    ViewBag.Title = "Home Page";

    var nombre = (string)ViewBag.NombreUsuario ?? "Usuario";
    var rol = (string)ViewBag.RolUsuario ?? "ADMINISTRADOR";

    var h = DateTime.Now.Hour;
    var saludo = (h < 12) ? "Buenos días" : (h < 19 ? "Buenas tardes" : "Buenas noches");

    // Datos demo por si aún no los traes del controller:
    var totalClientes = ViewBag.TotalClientes ?? 1234;
    var ventasTotales = ViewBag.VentasTotales ?? 45678.00m;
    var comprasActivas = ViewBag.ComprasActivas ?? 89;
    var totalProductos = ViewBag.TotalProductos ?? 456;
    var deltaClientes = ViewBag.DeltaClientes ?? "+12% este mes";
    var deltaVentas = ViewBag.DeltaVentas ?? "+23% este mes";
    var deltaCompras = ViewBag.DeltaCompras ?? "+5 esta semana";
    var deltaProductos = ViewBag.DeltaProductos ?? "+8 nuevos";
}

<div class="dash-container">

    <!-- Hero / Banner -->
    <div class="dash-hero card">
        <div>
            <h1 class="dash-hero-title">@saludo, @nombre</h1>
            <p class="dash-hero-sub">Bienvenido de vuelta a tu panel de control</p>
            <p class="dash-hero-foot">© @DateTime.Now.Year - Mi aplicación Mateo Quartin</p>
        </div>
        <span class="dash-role">@rol.ToString().ToUpper()</span>
    </div>

    <!-- Métricas -->
    <div class="row g-3 g-md-4 dash-metrics">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="dash-card card">
                <div class="dash-icon">@Html.Raw(DashIcons.Users)</div>
                <div class="dash-label">Total Clientes</div>
                <div class="dash-value">@String.Format("{0:N0}", totalClientes)</div>
                <div class="dash-delta text-success">@deltaClientes</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="dash-card card">
                <div class="dash-icon">@Html.Raw(DashIcons.Sales)</div>
                <div class="dash-label">Ventas Totales</div>
                <div class="dash-value">$@String.Format("{0:N0}", ventasTotales)</div>
                <div class="dash-delta text-success">@deltaVentas</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="dash-card card">
                <div class="dash-icon">@Html.Raw(DashIcons.Cart)</div>
                <div class="dash-label">Compras Activas</div>
                <div class="dash-value">@comprasActivas</div>
                <div class="dash-delta text-success">@deltaCompras</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="dash-card card">
                <div class="dash-icon">@Html.Raw(DashIcons.Box)</div>
                <div class="dash-label">Productos</div>
                <div class="dash-value">@totalProductos</div>
                <div class="dash-delta text-success">@deltaProductos</div>
            </div>
        </div>
    </div>

    <!-- Acciones Rápidas -->
    <div class="dash-actions card">
        <h2 class="dash-section-title">Acciones Rápidas</h2>

        <div class="row g-3 g-md-4">
            <div class="col-12 col-lg-6">
                <a href="@Url.Action("Create","Clientes")" class="dash-action card-link">
                    <div class="dash-action-card card">
                        <div class="dash-action-icon">@Html.Raw(DashIcons.UserPlus)</div>
                        <div>
                            <div class="dash-action-title">Nuevo Cliente</div>
                            <div class="dash-action-sub">Agregar un nuevo cliente al sistema</div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-lg-6">
                <a href="@Url.Action("Create","Ventas")" class="dash-action card-link">
                    <div class="dash-action-card card">
                        <div class="dash-action-icon">@Html.Raw(DashIcons.Receipt)</div>
                        <div>
                            <div class="dash-action-title">Nueva Venta</div>
                            <div class="dash-action-sub">Registrar una nueva transacción de venta</div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>

</div>

@section estilos{
    <style>
        /* Layout base */
        .dash-container {
            padding: 16px;
        }

        @@media (min-width:992px) {
            .dash-container {
                padding: 24px;
            }
        }

        /* Tarjetas base */
        .card {
            border: 0;
            border-radius: 14px;
            background: #ffffff;
            box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(22,28,45,.06);
        }

        /* Hero */
        .dash-hero {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 28px 24px;
            background: linear-gradient(180deg, rgba(0,186,199,.08), rgba(0,0,0,0));
            margin-bottom: 22px;
        }

        .dash-hero-title {
            margin: 0 0 6px;
            font-size: 28px;
            font-weight: 800;
            color: #111827;
        }

        .dash-hero-sub {
            margin: 0;
            color: #6b7280;
        }

        .dash-hero-foot {
            margin: 8px 0 0;
            color: #9ca3af;
            font-size: .95rem;
        }

        .dash-role {
            color: #0f766e;
            background: #d1fae5;
            font-weight: 700;
            letter-spacing: .04em;
            padding: 8px 12px;
            border-radius: 999px;
            align-self: center;
        }

        /* Métricas */
        .dash-metrics .dash-card {
            padding: 18px;
            height: 100%;
        }

        .dash-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            background: #f1f5f9;
        }

        .dash-label {
            color: #6b7280;
            font-weight: 600;
        }

        .dash-value {
            font-size: 28px;
            font-weight: 800;
            color: #0f172a;
            line-height: 1.15;
        }

        .dash-delta {
            margin-top: 6px;
            font-weight: 600;
        }

        /* Acciones rápidas */
        .dash-actions {
            padding: 20px;
            margin-top: 10px;
        }

        .dash-section-title {
            font-size: 20px;
            font-weight: 800;
            margin: 0 0 14px;
            color: #0f172a;
        }

        .card-link {
            text-decoration: none;
        }

        .dash-action-card {
            display: flex;
            gap: 14px;
            align-items: center;
            padding: 16px;
            transition: transform .08s ease, box-shadow .12s ease;
        }

            .dash-action-card:hover {
                transform: translateY(-1px);
                box-shadow: 0 2px 6px rgba(0,0,0,.06), 0 12px 28px rgba(22,28,45,.10);
            }

        .dash-action-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dash-action-title {
            font-weight: 800;
            color: #111827;
        }

        .dash-action-sub {
            color: #6b7280;
        }

        /* Grid helpers (si tu Bootstrap es 3, agrega gap simulado) */
        .g-3 > [class*="col-"] {
            margin-bottom: 12px;
        }

        .g-md-4 > [class*="col-"] {
            margin-bottom: 18px;
        }
    </style>
}

@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Home_Index.js")" type="text/javascript"></script>
}

