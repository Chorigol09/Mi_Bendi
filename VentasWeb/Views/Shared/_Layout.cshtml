@using VentasWeb.Helpers
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Expires" content="0">
    <meta http-equiv="Last-Modified" content="0">
    <meta http-equiv="Cache-Control" content="no-cache, mustrevalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <title>Mi Bendi</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Styles.Render("~/Content/PluginsCSS")

    <!-- Asegurar prioridad de Site.css -->
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")?v=6">

    @RenderSection("estilos", required: false)
</head>
<body>
    <!-- NUEVOOOOOO NAV -->
    <!-- NAVBAR -->
   
    <nav class="topbar navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid px-3">
            <!-- full ancho -->
            <div class="topbar-inner d-flex align-items-center w-100">

                <!-- Izquierda: Brand -->
                <a class="brand d-flex align-items-center text-white text-decoration-none mr-2" href="@Url.Action("Index","Home")">
                    <span class="logo-sq mr-2">MB</span>
                    <span class="brand-text">Mi Bendi</span>
                </a>

                <!-- Toggler movil -->
                <button class="navbar-toggler ml-auto d-lg-none" type="button" data-toggle="collapse"
                        data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Centro: Menu -->
                <div class="collapse navbar-collapse flex-grow-1" id="navbarSupportedContent">
                    <ul class="navbar-nav nav-center mx-lg-auto justify-content-lg-center align-items-center w-100">
                        <li class="nav-item">
                            <a class="nav-link" name="Home" href="@Url.Action("Index","Home")">
                                <i class="fas fa-home mr-2"></i>Inicio
                            </a>
                        </li>

                        @* Menus dinamicos por permisos *@
                        @Html.ActionLinkAllow()
                    </ul>

                    <!-- Derecha: Usuario + Salir -->
                    <ul class="navbar-nav ml-lg-auto align-items-center">
                        <li class="nav-item d-flex align-items-center">
                            <span id="userInitials" class="avatar mr-2">US</span>
                            <span id="userName" class="text-white font-weight-semibold">
                                @(User.Identity.Name)
                            </span>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Salir","Home")" class="nav-link">
                                <i class="fas fa-sign-out-alt mr-1"></i><strong>Salir</strong>
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </nav>

    <!-- CONTENIDO -->
    <div class="container-fluid mt-4">
        @RenderBody()
        
        <!-- FOOTER -->
        <div class="mbd-footer-spacer"></div>
        <footer class="mbd-footer">
            <div class="mbd-footer-sep"></div>
            <div class="mbd-footer-content">
                <p class="mbd-footer-text">&copy; @DateTime.Now.Year Mi Bendi. Todos los derechos reservados.</p>
            </div>
        </footer>
    </div>
    
    <style>
        /* ========== FOOTER MI BENDI (prefijo mbd-) ========== */
        
        .mbd-footer-spacer {
            height: 48px;
        }
        
        .mbd-footer {
            position: relative;
            background: linear-gradient(180deg, #fafbfc 0%, #f8f9fa 100%);
            margin-top: 0;
        }
        
        .mbd-footer-sep {
            height: 1px;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(0, 0, 0, 0.06) 20%, 
                rgba(0, 0, 0, 0.06) 80%, 
                transparent 100%);
            box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.03);
        }
        
        .mbd-footer-content {
            padding: 20px 0;
            text-align: center;
        }
        
        .mbd-footer-text {
            margin: 0;
            font-size: 12.5px;
            color: #6b7280;
            font-weight: 400;
            line-height: 1.6;
        }
        
        /* Estados de enlaces si existen */
        .mbd-footer a {
            color: #6b7280;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        
        .mbd-footer a:hover {
            color: #374151;
            text-decoration: underline;
        }
        
        .mbd-footer a:focus-visible {
            outline: 2px solid #1976D2;
            outline-offset: 2px;
            border-radius: 2px;
        }
        
        /* Responsive: ajuste de padding en mobile */
        @@media (max-width: 767.98px) {
            .mbd-footer-content {
                padding: 18px 1rem;
                padding-bottom: calc(18px + env(safe-area-inset-bottom));
            }
            
            .mbd-footer-text {
                font-size: 12px;
            }
        }
    </style>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/Content/PluginsJS")

<script type="text/javascript">
        $.extend({ MisUrls: { url: {}, urls: function (a) { $.extend($.MisUrls.url, a); } } });

        //CONTROLADOR ROL
        $.MisUrls.urls({ _ObtenerRoles: '@Url.Action("Obtener", "Rol")' });
        $.MisUrls.urls({ _GuardarRol: '@Url.Action("Guardar", "Rol")' });
        $.MisUrls.urls({ _EliminarRol: '@Url.Action("Eliminar", "Rol")' });

        //CONTROLADOR PERMISOS
        $.MisUrls.urls({ _ObtenerPermisos: '@Url.Action("Obtener", "Permisos")' });
        $.MisUrls.urls({ _GuardarPermisos: '@Url.Action("Guardar", "Permisos")' });

        //CONTROLADOR USUARIO
        $.MisUrls.urls({ _ObtenerUsuarios: '@Url.Action("Obtener", "Usuario")' });
        $.MisUrls.urls({ _GuardarUsuario: '@Url.Action("Guardar", "Usuario")' });
        $.MisUrls.urls({ _EliminarUsuario: '@Url.Action("Eliminar", "Usuario")' });

        //CONTROLADOR PROVEEDOR
        $.MisUrls.urls({ _ObtenerProveedores: '@Url.Action("Obtener", "Proveedor")' });
        $.MisUrls.urls({ _GuardarProveedor: '@Url.Action("Guardar", "Proveedor")' });
        $.MisUrls.urls({ _EliminarProveedor: '@Url.Action("Eliminar", "Proveedor")' });

        //CONTROLADOR CATEGORIA
        $.MisUrls.urls({ _ObtenerCategorias: '@Url.Action("Obtener", "Categoria")' });
        $.MisUrls.urls({ _GuardarCategoria: '@Url.Action("Guardar", "Categoria")' });
        $.MisUrls.urls({ _EliminarCategoria: '@Url.Action("Eliminar", "Categoria")' });

        //CONTROLADOR PRODUCTO
        $.MisUrls.urls({ _ObtenerProductos: '@Url.Action("Obtener", "Producto")' });
        $.MisUrls.urls({ _ObtenerProductosPorTienda: '@Url.Action("ObtenerPorTienda", "Producto")' });
        $.MisUrls.urls({ _GuardarProducto: '@Url.Action("Guardar", "Producto")' });
        $.MisUrls.urls({ _EliminarProducto: '@Url.Action("Eliminar", "Producto")' });
        $.MisUrls.urls({ _ObtenerAsignaciones: '@Url.Action("ObtenerAsignaciones", "Producto")' });
        $.MisUrls.urls({ _RegistrarProductoTienda: '@Url.Action("RegistrarProductoTienda", "Producto")' });
        $.MisUrls.urls({ _ModificarProductoTienda: '@Url.Action("ModificarProductoTienda", "Producto")' });
        $.MisUrls.urls({ _EliminarProductoTienda: '@Url.Action("EliminarProductoTienda", "Producto")' });
        $.MisUrls.urls({ _ActualizarPrecioVentaTienda: '@Url.Action("ActualizarPrecioVentaTienda", "Producto")' });

        //CONTROLADOR TIENDA
        $.MisUrls.urls({ _ObtenerTiendas: '@Url.Action("Obtener", "Tienda")' });
        $.MisUrls.urls({ _GuardarTienda: '@Url.Action("Guardar", "Tienda")' });
        $.MisUrls.urls({ _EliminarTienda: '@Url.Action("Eliminar", "Tienda")' });

        //CONTROLADOR COMPRA
        $.MisUrls.urls({ _ObtenerCompras: '@Url.Action("Obtener", "Compra")' });
        $.MisUrls.urls({ _GuardarCompra: '@Url.Action("Guardar", "Compra")' });
        $.MisUrls.urls({ _DocumentoCompra: '@Url.Action("Documento", "Compra")' });
        $.MisUrls.urls({ _ActualizarEstadoOC: '@Url.Action("ActualizarEstado", "Compra")' });

        //CONTROLADOR REMITO
        $.MisUrls.urls({ _ObtenerRemitos: '@Url.Action("Obtener", "Remito")' });
        $.MisUrls.urls({ _GuardarRemito: '@Url.Action("Guardar", "Remito")' });
        $.MisUrls.urls({ _ActualizarEstadoRemito: '@Url.Action("ActualizarEstado", "Remito")' });

        //CONTROLADOR FACTURA
        $.MisUrls.urls({ _ObtenerFacturas: '@Url.Action("Obtener", "Factura")' });
        $.MisUrls.urls({ _GuardarFactura: '@Url.Action("Guardar", "Factura")' });
        $.MisUrls.urls({ _ActualizarEstadoFactura: '@Url.Action("ActualizarEstado", "Factura")' });

        //CONTROLADOR VENTA
        $.MisUrls.urls({ _ObtenerUsuario: '@Url.Action("ObtenerUsuario", "Venta")' });
        $.MisUrls.urls({ _ObtenerProductoStockPorTienda: '@Url.Action("ObtenerProductoPorTienda", "Venta")' });
        $.MisUrls.urls({ _ControlarStockProducto: '@Url.Action("ControlarStock", "Venta")' });
        $.MisUrls.urls({ _RegistrarVenta: '@Url.Action("Guardar", "Venta")' });
        $.MisUrls.urls({ _DocumentoVenta: '@Url.Action("Documento", "Venta")' });
        $.MisUrls.urls({ _ObtenerVentas: '@Url.Action("Obtener", "Venta")' });

        //CONTROLADOR REPORTE
        $.MisUrls.urls({ _ObtenerReporteProducto: '@Url.Action("ObtenerReporteProducto", "Reportes")' });
        $.MisUrls.urls({ _ObtenerReporteVenta: '@Url.Action("ObtenerVenta", "Reportes")' });

        //CONTROLADOR CLIENTE
        $.MisUrls.urls({ _ObtenerClientes: '@Url.Action("Obtener", "Cliente")' });
        $.MisUrls.urls({ _GuardarCliente: '@Url.Action("Guardar", "Cliente")' });
        $.MisUrls.urls({ _EliminarCliente: '@Url.Action("Eliminar", "Cliente")' });

        $.MisUrls.urls({ _AjustarStock: '@Url.Action("AjustarStock", "Producto")' });
        $.MisUrls.urls({ _ActualizarPrecioVenta: '@Url.Action("ActualizarPrecioVenta","Producto")' });

        //CONTROLADOR MOVIMIENTO STOCK
        $.MisUrls.urls({ _ObtenerMovimientos: '@Url.Action("Obtener", "MovimientoStock")' });
        $.MisUrls.urls({ _ObtenerMovimientosAgrupados: '@Url.Action("ObtenerAgrupados", "MovimientoStock")' });
        $.MisUrls.urls({ _GuardarMovimiento: '@Url.Action("Guardar", "MovimientoStock")' });
        $.MisUrls.urls({ _ObtenerProductosPorTienda: '@Url.Action("ObtenerProductosPorTienda", "MovimientoStock")' });
        $.MisUrls.urls({ _ObtenerTiposMov: '@Url.Action("ObtenerTiposMov", "MovimientoStock")' });

        //lenguaje espanol datatable
        $.MisUrls.urls({ Url_datatable_spanish: '@Url.Content("~/content/plugins/datatables/js/datatable_spanish.json")' });

</script>

    <script>
        // Marca activo via name (si lo usas en vistas)
        function activarMenu(menuactivo) {
            var ul = $("ul.navbar-nav");
            ul.find("li.nav-item").each(function (i, li) {
                var a;
                if ($(li).find("div.dropdown-menu").length != 0) {
                    var div = $($(li).find("div.dropdown-menu"))
                    div.find("a.dropdown-item").each(function (x, tagA) {
                        if ($(tagA).attr("name") == menuactivo) {
                            $(li).addClass("active");
                            return false;
                        }
                    })
                } else {
                    a = $(li).find("a.nav-link");
                    if ($(a).attr("name") == menuactivo) {
                        $(li).addClass("active");
                        return false;
                    }
                }
            });
        }

        // Iniciales automaticas del usuario
        (function () {
            var nameNode = document.getElementById('userName');
            var initialsNode = document.getElementById('userInitials');
            if (!nameNode || !initialsNode) return;

            var name = (nameNode.textContent || "").trim();
            var initials = name.split(/\s+/).map(function (w) { return w[0]; }).slice(0, 2).join('').toUpperCase();
            initialsNode.textContent = initials || 'US';
        })();
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
