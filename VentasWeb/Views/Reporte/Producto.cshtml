@{
    ViewBag.Title = "Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section estilos{
    <style>
        #inner-right {
            max-height: 300px;
            overflow-y: scroll;
        }

        .btn-group.btn-group-sm .btn {
            min-width: 32px;
        }
    </style>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Reportes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Productos por tienda</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                Reportes de productos por tienda
            </div>
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label for="cboTienda" class="col-form-label col-form-label-sm">Tienda:</label>
                            <select class="form-control form-control-sm model" id="cboTienda" name="Tienda"></select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <label for="txtCodigoProducto" class="col-form-label col-form-label-sm">Codigo Producto:</label>
                            <input type="text" class="form-control form-control-sm model" id="txtCodigoProducto" name="codigoproducto" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group mb-0">
                            <button id="btnBuscar" type="button" class="btn btn-sm btn-primary btn-block">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="row mb-2">
                    <div class="col-sm-12">
                        <button class="btn btn-info float-left" onclick="printData()">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    </div>
                </div>

                <div class="row" id="inner-right">
                    <div class="col-sm-12">
                        <table id="tbReporte" class="table table-striped table-bordered table-sm table-responsive-sm" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Ruc Tienda</th>
                                    <th>Nombre Tienda</th>
                                    <th>Direccion Tienda</th>
                                    <th>Codigo Producto</th>
                                    <th>Nombre Producto</th>
                                    <th>Descripcion Producto</th>
                                    <th>Stock en tienda</th>
                                    <th>Precio Venta</th>
                                    <th>Modificar Precio</th>
                                    <th>Editar Stock</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalPrecioVenta" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="modalPrecioVentaLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalPrecioVentaLabel">Modificar Precio de Venta</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtIdProductoTiendaModal" />
                <div class="form-group">
                    <label><strong>Producto:</strong></label>
                    <input type="text" class="form-control form-control-sm" id="txtProductoNombreModal" readonly />
                </div>
                <div class="form-group">
                    <label><strong>Tienda:</strong></label>
                    <input type="text" class="form-control form-control-sm" id="txtTiendaNombreModal" readonly />
                </div>
                <div class="form-group">
                    <label for="txtNuevoPrecioVentaModal"><strong>Nuevo Precio de Venta:</strong></label>
                    <input type="number" step="0.01" min="0" class="form-control form-control-sm" id="txtNuevoPrecioVentaModal" placeholder="Ingrese el precio de venta" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-success" id="btnGuardarPrecioModal">
                    <i class="fas fa-save"></i> Guardar Precio
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/Views/Reporte_Producto.js?v=9"></script>
}
